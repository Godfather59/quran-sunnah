# Preserve exact bytes for verified religious datasets across platforms.
# Without this, Windows checkouts (core.autocrlf=true) convert LF -> CRLF
# and break assets/integrity_manifest.json (git-blob-sha1) + SHA-256 checks.
.gitattributes text eol=lf
.gitignore text eol=lf
assets/** text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.plist text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.dart text eol=lf

# Binary - never convert.
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.mp3 binary
