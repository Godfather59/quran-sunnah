    "scriptExplanation" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير الرسم يغيّر طريقة العرض فقط، ولا يغيّر ألفاظ القرآن أو معناه."
