    "riwayaExplanation" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القراءة هي الأصل، والرواية طريق نقلها. كل رواية هنا تعتمد على نص موثق مستقل، ولا يتم استبدال الكلمات برمجيًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qira’a is the canonical reading and Riwaya is its transmission. Each Riwaya uses its own verified dataset; wording is never substituted programmatically."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qira’a est la lecture de référence et la riwaya sa transmission. Chaque riwaya utilise son propre jeu de données vérifié ; le texte n’est jamais remplacé artificiellement."
          }
        }
      }
    },
